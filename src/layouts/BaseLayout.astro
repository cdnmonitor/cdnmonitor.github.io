---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site, socials, primary } from '../site.config';
import { basePath } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  /** Page's canonical path, e.g. /projects/type65/ */
  path: string;
  noindex?: boolean;
}

const { title, description = site.description, path, noindex = false } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(path, site.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />

    {/* The two faces on the first screen: body and labels. The display line is
        Geist 500, so that weight is preloaded too. */}
    <link rel="preload" href={basePath('/fonts/geist-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={basePath('/fonts/geist-500.woff2')} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={basePath('/favicon.svg')} type="image/svg+xml" />

    {/* Page transitions. Cross-document View Transitions (the CSS-only route)
        are Chrome-only today — Firefox and Safari skip the rule — so the router
        fetches the next page and runs the swap inside
        document.startViewTransition, which Gecko and WebKit both support. It is
        the only script on the site, and every link still works without it. */}
    <ClientRouter />

    <style is:inline>
      /* Anti-flash base: the stylesheet is inlined after this, but the page
         must never paint in a fallback face at full size. */
      html { background: #fff; }
    </style>
  </head>

  <body>
    <div class="shell">
      <header class="site-head">
        <a class="wordmark" href={basePath('/')}>{site.name}</a>
        <nav class="site-nav" aria-label="Primary">
          {primary.map((link) => (
            <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-foot">
        <span>© {year} {site.name}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {socials.map((link) => (
          <a href={link.href} rel="me">{link.label}</a>
        ))}
        <span class="spacer"></span>
        <span>{site.location}</span>
      </footer>
    </div>
  </body>
</html>
