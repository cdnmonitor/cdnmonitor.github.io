---
import '../styles/global.css';
import { site, socials, primary } from '../site.config';

export interface Props {
  title: string;
  description?: string;
  /** Page's canonical path, e.g. /work/type65/ */
  path: string;
  noindex?: boolean;
}

const { title, description = site.description, path, noindex = false } = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(path, site.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />

    {/* The two faces on the first screen: body and labels. The display line is
        Geist 500, so that weight is preloaded too. */}
    <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/iosevka-charon-700.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <style is:inline>
      /* Anti-flash base: the stylesheet is inlined after this, but the page
         must never paint in a fallback face at full size. */
      html { background: #fff; }
    </style>
  </head>

  <body>
    <div class="shell">
      <header class="site-head">
        <a class="wordmark" href="/">{site.name}</a>
        <nav class="site-nav" aria-label="Primary">
          {primary.map((link) => (
            <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))}
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-foot">
        <span>© {year} {site.name}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {socials.map((link) => (
          <a href={link.href} rel="me">{link.label}</a>
        ))}
        <span class="spacer"></span>
        <span>{site.location}</span>
      </footer>
    </div>
  </body>
</html>
