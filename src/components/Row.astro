---
/**
 * One row in a register (work, experiences, writing): the title and its summary,
 * optional tags in the meta voice, and a right-edge label (year, date).
 * Text only — a frame without artwork is a hole, so the row is the typography.
 */
export interface Props {
  href: string;
  title: string;
  summary?: string;
  tags?: string[];
  /** Right-edge label: a year for projects, a date for posts. */
  meta?: string;
}

const { href, title, summary, tags = [], meta } = Astro.props;
---

<li>
  <a class="row" href={href}>
    <span class="row-main">
      <span class="row-title">{title}</span>
      {summary && <span class="row-summary">{summary}</span>}
      {tags.length > 0 && <span class="row-tags">{tags.join(' · ')}</span>}
    </span>

    {meta && <span class="row-meta">{meta}</span>}
  </a>
</li>
