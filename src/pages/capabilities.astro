---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCapabilities } from '../lib/capabilities';
import { basePath } from '../lib/site';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const capabilities = await getCapabilities();
const bodies = await Promise.all(capabilities.map((capability) => render(capability)));

/* Capability artwork lives beside its markdown, so a discipline's photo and the
   words about it are edited in the same place. The glob is eager because the
   page needs every image at build time anyway. */
const artwork = import.meta.glob<ImageMetadata>('../content/capabilities/*.{jpg,jpeg,png}', {
  eager: true,
  import: 'default',
});
const artworkFor = (file?: string) =>
  file ? artwork[`../content/capabilities/${file}`] : undefined;
---

<BaseLayout
  title="Capabilities"
  description="What Michael Bishai does: software, mechanical design, machining, electronics and firmware, graphics and editing, and operations."
  path={basePath('/capabilities/')}
>
  <section class="hero">
    <h1>What I do.</h1>
    <div class="lede">
      <p>
        One workshop, six disciplines: the part designed and machined here, the board and
        firmware that go in it, the site that sells it, and the graphics that show it.
      </p>
    </div>
  </section>

  {/* The breadth in one line, before the detail — this is the list someone
      scanning for "does this person do X" actually reads. */}
  <nav class="cap-index" aria-label="Jump to a discipline">
    {capabilities.map((capability) => (
      <a href={`#${capability.id}`}>{capability.data.title}</a>
    ))}
  </nav>

  <section class="page-body">
    <div class="capabilities">
      {capabilities.map((capability, i) => {
        const { Content } = bodies[i];
        const image = artworkFor(capability.data.image);
        return (
          <article class:list={['capability', image && 'has-image']} id={capability.id}>
            <div class="capability-text">
              <h2 class="capability-title">{capability.data.title}</h2>
              <p class="capability-summary">{capability.data.summary}</p>
              <div class="prose capability-body"><Content /></div>
            </div>
            {image && (
              <figure class="capability-figure">
                <Image
                  src={image}
                  alt={capability.data.imageAlt ?? ''}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 48rem) 20rem, 100vw"
                />
              </figure>
            )}
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
