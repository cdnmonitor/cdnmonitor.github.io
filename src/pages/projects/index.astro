---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Row from '../../components/Row.astro';
import { getProjects, projectPath } from '../../lib/projects';
import { basePath } from '../../lib/site';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Projects in software, fabrication and hardware." path={basePath('/projects/')}>
  <section class="hero">
    <h1>Projects</h1>
    <div class="lede">
      <p>Each entry is a markdown file: what the problem was, what was built, and what it cost.</p>
    </div>
  </section>

  <section class="page-body">
    <ul class="register">
      {projects.map((project) => (
        <Row
          href={projectPath(project)}
          title={project.data.title}
          summary={project.data.summary}
          tags={project.data.tags}
          meta={String(project.data.year)}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
