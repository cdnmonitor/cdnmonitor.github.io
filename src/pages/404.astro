---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath } from '../lib/site';
---

<BaseLayout title="Not found" path={basePath('/404')} noindex>
  <section class="hero">
    <h1>That page isn’t here.</h1>
    <div class="lede">
      <p>The link is broken or the file moved. <a href={basePath('/')}>Home</a> lists the work.</p>
    </div>
  </section>
</BaseLayout>
