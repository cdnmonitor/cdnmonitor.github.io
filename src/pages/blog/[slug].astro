---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, postNeighbours, postPath, type Post } from '../../lib/posts';
import { formatDate, isoDate, readingTime } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const { prev, next } = postNeighbours(posts, post);
    return { params: { slug: post.id }, props: { post, prev, next } };
  });
}

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props;
const { title, summary, date, tags, standfirst } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={summary} path={postPath(post)}>
  <article class="article">
    <h1 class="page-title">{title}</h1>
    <p class="page-standfirst">{standfirst ?? summary}</p>

    <p class="article-meta">
      <span class="meta-when">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
      </span>
      {tags.length > 0 && <span class="meta-tags">{tags.join(' · ')}</span>}
    </p>

    <div class="prose"><Content /></div>

    {(prev || next) && (
      <nav class="pager" aria-label="More posts">
        {prev && (
          <a class="pager-link" href={postPath(prev)}>
            <span class="dir">Newer</span>
            <span class="to">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="pager-link next" href={postPath(next)}>
            <span class="dir">Older</span>
            <span class="to">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
