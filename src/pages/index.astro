---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { Image } from 'astro:assets';
import heroPortrait from '../assets/hero-portrait.jpg';
import { getEntry, render } from 'astro:content';
import { getExperiences, experiencePath } from '../lib/experience';
import { site } from '../site.config';
import { basePath } from '../lib/site';

const [home, experiences] = await Promise.all([getEntry('pages', 'home'), getExperiences()]);
if (!home) throw new Error('[pages] missing src/content/pages/home.md');

const { Content: Intro } = await render(home);
---

<BaseLayout title={site.name} path={basePath('/')}>
  <section class="hero hero-split">
    <div class="hero-text">
      <h1>{home.data.heading ?? home.data.title}</h1>
      <div class="lede"><Intro /></div>
    </div>

    {/* Portrait for the intro. Served as a hash-named WebP at the widths the
        column can actually use (17.5rem is its cap). */}
    <div class="hero-media">
      <Image
        src={heroPortrait}
        alt="Michael Bishai in the shop between machines, holding a machined aluminum part in one hand and a finished keyboard in the other, with the Haas Mini Mill behind him."
        widths={[320, 480, 640, 800]}
        sizes="(max-width: 48rem) 16rem, (max-width: 64rem) 20vw, 17.5rem"
        format="webp" quality={65}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="page-body" aria-labelledby="experience-heading">
    <div class="section-head">
      <h2 class="section-title" id="experience-heading">Experience &amp; research</h2>
    </div>

    <ul class="register">
      {experiences.map((experience) => (
        <Row
          href={experiencePath(experience)}
          title={experience.data.title}
          summary={experience.data.summary}
          tags={[experience.data.role]}
          meta={experience.data.years}
        />
      ))}
    </ul>
  </section>
</BaseLayout>
