---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { getProjects, projectPath } from '../lib/projects';
import { getPosts, postPath } from '../lib/posts';
import { formatDate, plural } from '../lib/site';
import { getEntry, render } from 'astro:content';
import { site } from '../site.config';

const [projects, posts] = await Promise.all([getProjects(), getPosts()]);

const home = await getEntry('pages', 'home');
if (!home) throw new Error('[pages] missing src/content/pages/home.md');
const { Content: Intro } = await render(home);
---

<BaseLayout title={site.name} path="/">
  <section class="hero">
    <p class="page-eyebrow">{site.role} <span class="sep">/</span> {site.location}</p>
    <h1>{home.data.heading ?? home.data.title}</h1>
    <div class="lede"><Intro /></div>
  </section>

  <section class="page-section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 class="section-title" id="work-heading">Selected work</h2>
      <span class="section-rule" aria-hidden="true"></span>
      <span class="section-count">{plural(projects.length, 'project')}</span>
    </div>

    <ul class="register">
      {projects.map((project, i) => (
        <Row
          href={projectPath(project)}
          index={i + 1}
          title={project.data.title}
          summary={project.data.summary}
          tags={project.data.tags}
          meta={String(project.data.year)}
        />
      ))}
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="page-body" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 class="section-title" id="writing-heading">Writing</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{plural(posts.length, 'post')}</span>
      </div>

      <ul class="register">
        {posts.slice(0, 3).map((post, i) => (
          <Row
            href={postPath(post)}
            index={i + 1}
            title={post.data.title}
            summary={post.data.summary}
            tags={post.data.tags}
            meta={formatDate(post.data.date)}
          />
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
